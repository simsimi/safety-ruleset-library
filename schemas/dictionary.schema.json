{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "사전 파일은 YAML이다. YAML을 변환한 구조가 이 스키마를 따라야 한다. patterns/excludes 안의 id 유일성은 검증 도구 책임이다.",
  "properties": {
    "description": {
      "type": "string"
    },
    "excludes": {
      "description": "제외 패턴. 매칭보다 먼저 적용해, 상대에게 하는 말처럼 위험이 아닌 구간을 지운다. 절(clause) 단위 제외 같은 복잡한 로직은 사전이 아니라 탐지기 코드 내장 규칙이 담당하고, 여기는 단순 정규식 구간 제거만 적는다.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "pattern": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "default": "regex",
            "description": "제외는 정규식만 쓴다. 공백을 한 칸으로 줄인 원문에서 걸린 구간을 제거한다.",
            "enum": [
              "regex"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "pattern"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "description": "사전 이름. 예: default",
      "minLength": 1,
      "type": "string"
    },
    "patterns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "description": "자유 분류 태그. 예: suicide, self_harm.",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "description": "false면 이 패턴은 건너뛴다. 패턴을 지우지 않고 끄는 용도.",
            "type": "boolean"
          },
          "id": {
            "description": "패턴 식별자. predictions의 matches.pattern_id가 이를 참조한다.",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "pattern": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "description": "phrase=공백을 제거한 텍스트에서 부분 문자열로 매칭(패턴 자체도 공백 없이 적는다). regex=공백을 한 칸으로 줄인 원문에 정규식 검색.",
            "enum": [
              "phrase",
              "regex"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "pattern"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "description": "사전 버전. 예: 0.1.0. predictions·리포트에 이 값이 기록된다.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "patterns"
  ],
  "title": "riskcheck 단어 사전 (YAML)",
  "type": "object"
}
