{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "predictions 파일은 JSONL이다. 각 줄이 테스트셋 항목 하나에 대한 한 단계(stage)의 판정 결과다. 단계 결과를 따로 저장하므로, 한 단계만 바꾸면 그 단계 파일만 다시 만든다.",
  "properties": {
    "error": {
      "description": "판정 실패 사유. 성공이면 null 또는 생략.",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "테스트셋 항목의 id.",
      "minLength": 1,
      "type": "string"
    },
    "matches": {
      "description": "걸린 패턴 목록. 판정이 none이면 빈 배열이다. 오류 건도 빈 배열로 둔다.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "matched": {
            "description": "실제로 걸린 문자열.",
            "type": "string"
          },
          "pattern_id": {
            "description": "사전 patterns의 id.",
            "type": "string"
          },
          "span": {
            "description": "[시작, 끝) 위치. regex 매칭처럼 원문 위치가 있는 경우만 적는다. phrase 매칭은 공백 제거 텍스트 기준이라 원문 위치로 환산하지 않고 생략한다.",
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "pattern_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "predicted": {
      "description": "판정. risk=위험, none=비위험 (이진). 오류로 판정하지 못했으면 null이고 error에 사유를 적는다. 오류 건은 지표 계산의 분모에서 제외한다.",
      "enum": [
        "none",
        "risk",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "scores": {
      "additionalProperties": false,
      "description": "모델 단계 전용. 사전 단계는 쓰지 않는다.",
      "properties": {
        "anxiety": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "depression": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "else": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "source_version": {
      "description": "이 결과를 만든 사전 버전 또는 모델 버전. 재실행 여부를 가르는 키의 일부다.",
      "type": "string"
    },
    "stage": {
      "description": "이 결과를 만든 단계. dict=단어 사전 단계, model=분류모델 단계(후속).",
      "enum": [
        "dict",
        "model"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "stage",
    "predicted",
    "matches"
  ],
  "title": "riskcheck 단계별 판정 결과 항목 (JSONL 한 줄)",
  "type": "object"
}
